{
  "manifest_version": 3,
  "name": "Feed Analyzer",
  "version": "0.2.0",
  "description": "Shows what share of your X feed is clickbait, news, outrage, or other.",
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "feed-analyzer@class-project.local",
      "strict_min_version": "121.0"
    }
  },
  "action": {
    "default_title": "Feed Analyzer",
    "default_popup": "popup.html"
  },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://x.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*"
  ]
}
